# ========================================================
# BHARATKART E-COMMERCE MARKETPLACE ENVIRONMENT TEMPLATE
# ========================================================

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bharatkart?sslmode=disable"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="bharatkart"

# Medusa Headless Backend Integration
MEDUSA_BACKEND_URL="http://localhost:9000"
MEDUSA_PUBLISHABLE_KEY="pk_test_sample"

# Authentication & Session Security
JWT_SECRET="your_jwt_secret_here"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Razorpay Payment Gateway (Test Credentials)
RAZORPAY_KEY_ID="rzp_test_sample_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_sample_key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
